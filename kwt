#!/usr/bin/env bash
#
# kwt — run kit in a bwrap sandbox
#
# Runs kit inside a default-deny bwrap sandbox rooted at a directory. The
# directory is the only writable source tree; the Project's git state, the
# host's tools, kit's configuration, and the user's agent skills are mounted
# read-only. See .scratch/kwt/spec.md for the specification.
#
set -euo pipefail

PROG=kwt

# ---------------------------------------------------------------------------
# State populated by resolution and command parsing.
# ---------------------------------------------------------------------------
TARGET_DIR=""
GIT_DIRS=()
ALLOW_GIT_WRITE=0
DRY_RUN=0
HEADLESS=0
PROMPT=()
SANDBOX_ARGV=()
RO_BIND_SOURCES=()

die() { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
usage:
  kwt [<dir>] [--allow-git-write] [--dry-run] [-- <prompt>...]
  kwt shell [<dir>] [--allow-git-write] [--dry-run]

options:
      --allow-git-write make git state writable inside the sandbox
      --dry-run         print the plan and perform no side effects
  -h, --help            show this help

<dir> defaults to the current directory.
EOF
}

# ---------------------------------------------------------------------------
# Resolution
# ---------------------------------------------------------------------------
# Resolve the Target directory to an absolute path. The filesystem root is
# refused: making it writable would defeat the sandbox.
resolve_dir() {
  local dir=$1
  [ -d "$dir" ] || die "not a directory: $dir"
  TARGET_DIR=$(cd "$dir" && pwd -P)
  if [ "$TARGET_DIR" = "/" ]; then
    die "refusing to sandbox the filesystem root"
  fi
}

# Absolute git directories for the Target directory. Empty when the Target is
# not a git checkout root. Both the checkout's git dir and the common dir are
# returned when they differ.
resolve_git_dirs() {
  GIT_DIRS=()
  [ -e "$TARGET_DIR/.git" ] || return 0
  local common gitdir
  common=$(git -C "$TARGET_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  gitdir=$(git -C "$TARGET_DIR" rev-parse --path-format=absolute --git-dir 2>/dev/null) || gitdir=$common
  common=$(cd "$common" 2>/dev/null && pwd -P) || return 0
  GIT_DIRS+=("$common")
  gitdir=$(cd "$gitdir" 2>/dev/null && pwd -P) || gitdir=""
  if [ -n "$gitdir" ] && [ "$gitdir" != "$common" ]; then
    GIT_DIRS+=("$gitdir")
  fi
}

# ---------------------------------------------------------------------------
# Sandbox
# ---------------------------------------------------------------------------
KIT_BIN=""

# Resolve kit once. `command -v` may return a symlink, so follow it: the
# sandbox must bind the directory that really holds the binary.
kit_binary() {
  if [ -z "$KIT_BIN" ]; then
    local found
    found=$(command -v kit) || die "kit not found on PATH"
    KIT_BIN=$(readlink -f "$found") || die "cannot resolve the kit binary at $found"
  fi
  printf '%s' "$KIT_BIN"
}

# Record a read-only bind unless an earlier mount already covers it. The
# system directories are mounted wholesale, and a bind of a parent directory
# already covers its children.
ro_bind_covered() {
  local path=$1 existing
  case "$path" in
    /usr|/usr/*|/bin|/bin/*|/lib|/lib/*|/lib64|/lib64/*|/etc|/etc/*|/run|/run/*) return 0 ;;
  esac
  for existing in ${RO_BIND_SOURCES[@]+"${RO_BIND_SOURCES[@]}"}; do
    if [ "$path" = "$existing" ]; then return 0; fi
    case "$path" in "$existing"/*) return 0 ;; esac
  done
  return 1
}

add_ro_bind() {
  local path=$1
  if ro_bind_covered "$path"; then return 0; fi
  RO_BIND_SOURCES+=("$path")
  SANDBOX_ARGV+=(--ro-bind "$path" "$path")
}

# Tools that live outside the system directories — `uvx`, cargo, pnpm and the
# like — are reached through PATH. Mount each PATH directory read-only so a
# sandboxed session can run them; a tool that is a symlink into another
# directory also needs its real target mounted, or the link dangles.
bind_path_tools() {
  local dir resolved entry target s
  local -a seen=()
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    [ -d "$dir" ] || continue
    resolved=$(readlink -f "$dir") || continue
    [ "$resolved" = "/" ] && continue
    # The Target directory and /tmp are bound separately, and kit's session
    # store is deliberately never mounted (sessions are ephemeral).
    case "$resolved" in
      "$TARGET_DIR"|"$TARGET_DIR"/*|/tmp|"$HOME/.kit"|"$HOME/.kit"/*) continue ;;
    esac
    for s in ${seen[@]+"${seen[@]}"}; do
      [ "$resolved" = "$s" ] && continue 2
    done
    seen+=("$resolved")
    if ro_bind_covered "$resolved"; then continue; fi
    add_ro_bind "$resolved"
    for entry in "$resolved"/*; do
      [ -L "$entry" ] || continue
      [ -x "$entry" ] || continue
      target=$(readlink -f "$entry") || continue
      add_ro_bind "$(dirname "$target")"
    done
  done < <(printf '%s\n' "${PATH:-}" | tr ':' '\n')
}

# The developer edits files inside kit with $EDITOR, which is vim or nvim. Mount
# that editor's configuration, plugin, and runtime directories so a sandboxed
# session has the developer's setup and plugins. Everything is read-only except
# nvim's state directory, which nvim writes to at startup (its log, shada, and
# undo files); a read-only state directory makes nvim fail to start. $EDITOR may
# carry arguments (`nvim -f`) or a path; only the program name matters.
# Directories that do not exist are skipped, so a bare editor install adds no
# mounts.
bind_editor_config() {
  local editor=${EDITOR:-}
  local config_home data_home state_home cache_home
  editor=${editor%% *}
  [ -n "$editor" ] || return 0
  editor=$(basename "$editor")
  config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  case "$editor" in
    nvim)
      data_home=${XDG_DATA_HOME:-$HOME/.local/share}
      state_home=${XDG_STATE_HOME:-$HOME/.local/state}
      cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
      if [ -e "$config_home/nvim" ]; then add_ro_bind "$config_home/nvim"; fi
      if [ -e "$data_home/nvim" ]; then add_ro_bind "$data_home/nvim"; fi
      if [ -e "$state_home/nvim" ]; then
        SANDBOX_ARGV+=(--bind "$state_home/nvim" "$state_home/nvim")
      fi
      if [ -e "$cache_home/nvim" ]; then add_ro_bind "$cache_home/nvim"; fi
      ;;
    vim|vi)
      if [ -e "$config_home/vim" ]; then add_ro_bind "$config_home/vim"; fi
      if [ -e "$HOME/.vim" ]; then add_ro_bind "$HOME/.vim"; fi
      if [ -e "$HOME/.vimrc" ]; then add_ro_bind "$HOME/.vimrc"; fi
      ;;
  esac
}

build_sandbox() {
  local kit_dir t config_home
  kit_dir=$(dirname "$(kit_binary)")
  RO_BIND_SOURCES=()

  SANDBOX_ARGV=(bwrap --die-with-parent
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --ro-bind /lib /lib
  )
  if [ -d /lib64 ]; then SANDBOX_ARGV+=(--ro-bind /lib64 /lib64); fi
  SANDBOX_ARGV+=(--ro-bind /etc /etc)
  if [ -d /run ]; then SANDBOX_ARGV+=(--ro-bind /run /run); fi
  SANDBOX_ARGV+=(--dev /dev --proc /proc --bind /tmp /tmp)

  # The Target directory is the single writable work area.
  SANDBOX_ARGV+=(--bind "$TARGET_DIR" "$TARGET_DIR")

  # Git state: read-only by default, writable only when explicitly allowed.
  for t in ${GIT_DIRS[@]+"${GIT_DIRS[@]}"}; do
    if [ "$ALLOW_GIT_WRITE" = 1 ]; then
      SANDBOX_ARGV+=(--bind "$t" "$t")
    else
      SANDBOX_ARGV+=(--ro-bind "$t" "$t")
    fi
  done

  # Every tool directory on PATH, so sandboxed sessions can run the same
  # commands the host can.
  bind_path_tools

  # Everything needed to run: the kit binary's directory and kit's config.
  # kit reads its config from $XDG_CONFIG_HOME (default ~/.config): the `kit`
  # directory holds settings, and `.kit` holds provider credentials and MCP
  # tokens. Both are mounted read-only so a sandboxed session can authenticate
  # but cannot write secrets.
  add_ro_bind "$kit_dir"
  config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  if [ -e "$config_home/kit" ]; then
    add_ro_bind "$config_home/kit"
  fi
  if [ -e "$config_home/.kit" ]; then
    add_ro_bind "$config_home/.kit"
  fi
  if [ -e "$HOME/.kit.yml" ]; then
    add_ro_bind "$HOME/.kit.yml"
  fi

  # User-level agent skills are readable but never writable from a sandboxed
  # session, so an agent cannot rewrite the instructions it runs under.
  if [ -e "$HOME/.agents" ]; then
    add_ro_bind "$HOME/.agents"
  fi

  # The developer's editor setup, read-only, so a sandboxed session can edit
  # with vim or nvim as configured but cannot rewrite that configuration.
  bind_editor_config

  # No session store is mounted. The kit launch passes --no-session (see
  # cmd_run), so kit keeps the conversation in memory and never opens a session
  # directory; leaving the host store out of the sandbox also keeps every other
  # session's transcript out of reach.

  # A kwt launch is unattended by definition, so ask kit's headless extension
  # (extensions/00-headless.go) to start active: the worker cannot then block on
  # a question or a privilege password. The session can be made interactive
  # again from inside with /headless.
  if [ "$HEADLESS" = 1 ]; then
    SANDBOX_ARGV+=(--setenv KIT_OPT_HEADLESS true)
  fi

  SANDBOX_ARGV+=(--chdir "$TARGET_DIR" --setenv HOME "$HOME" --setenv GIT_OPTIONAL_LOCKS 0)
  SANDBOX_ARGV+=(--)
  SANDBOX_ARGV+=("$@")
}

quote_join() {
  local out="" a
  for a in "$@"; do out+=$(printf '%q ' "$a"); done
  printf '%s' "${out% }"
}

# ---------------------------------------------------------------------------
# Plan
# ---------------------------------------------------------------------------
emit_plan() {
  printf 'dir %s\n' "$TARGET_DIR"
  if [ "${#SANDBOX_ARGV[@]}" -gt 0 ]; then
    printf 'sandbox %s\n' "$(quote_join "${SANDBOX_ARGV[@]}")"
  fi
}

# ---------------------------------------------------------------------------
# `kwt <dir>`
# ---------------------------------------------------------------------------
cmd_run() {
  local dir="" allow_git_write=0 dry_run=0
  local -a prompt=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; prompt=("$@"); break ;;
      --allow-git-write) allow_git_write=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *)
        if [ -n "$dir" ]; then die "unexpected argument: $1"; fi
        dir=$1; shift ;;
    esac
  done
  [ -z "$dir" ] && dir="."

  resolve_dir "$dir"
  ALLOW_GIT_WRITE=$allow_git_write
  DRY_RUN=$dry_run
  HEADLESS=1
  PROMPT=()
  if [ "${#prompt[@]}" -gt 0 ]; then PROMPT=("${prompt[@]}"); fi
  resolve_git_dirs

  # --no-session keeps the conversation in memory. kwt mounts no session store,
  # so a durable session would have nowhere to live (see build_sandbox).
  local -a kit_argv=(--no-daemon --no-session)
  if [ "${#PROMPT[@]}" -gt 0 ]; then kit_argv+=("${PROMPT[@]}"); fi
  build_sandbox "$(kit_binary)" "${kit_argv[@]}"

  if [ "$DRY_RUN" = 1 ]; then
    emit_plan
    return 0
  fi

  exec "${SANDBOX_ARGV[@]}"
}

# ---------------------------------------------------------------------------
# `kwt shell <dir>`
# ---------------------------------------------------------------------------
cmd_shell() {
  local dir="" allow_git_write=0 dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; break ;;
      --allow-git-write) allow_git_write=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1" ;;
      *)
        if [ -n "$dir" ]; then die "unexpected argument: $1"; fi
        dir=$1; shift ;;
    esac
  done
  [ -z "$dir" ] && dir="."

  resolve_dir "$dir"
  ALLOW_GIT_WRITE=$allow_git_write
  DRY_RUN=$dry_run
  HEADLESS=0
  resolve_git_dirs
  build_sandbox "${SHELL:-/bin/bash}"

  if [ "$DRY_RUN" = 1 ]; then
    emit_plan
    return 0
  fi

  exec "${SANDBOX_ARGV[@]}"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
main() {
  if [ $# -eq 0 ]; then
    cmd_run "."
    exit $?
  fi
  case "$1" in
    shell) shift; cmd_shell "$@" ;;
    -h|--help|help) usage; exit 0 ;;
    *) cmd_run "$@" ;;
  esac
}

main "$@"

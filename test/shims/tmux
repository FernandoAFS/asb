#!/usr/bin/env bash
# Stateful tmux shim for kwt tests.
#
# Sessions are directories under $TMUX_STATE/sessions and windows are files
# within them. Every invocation is appended to $SHIM_LOG so tests can assert on
# the argv kwt passed to tmux.
set -u

LOG=${SHIM_LOG:?SHIM_LOG is not set}
STATE=${TMUX_STATE:?TMUX_STATE is not set}
mkdir -p "$STATE/sessions"

printf 'tmux %s\n' "$*" >>"$LOG"

cmd=${1:-}
shift || true

sess=""
win=""
cwd=""
fmt=""
pos=()
while [ $# -gt 0 ]; do
  case "$1" in
    -t) sess=${2:-}; shift 2 ;;
    -s) sess=${2:-}; shift 2 ;;
    -n) win=${2:-}; shift 2 ;;
    -c) cwd=${2:-}; shift 2 ;;
    -F) fmt=${2:-}; shift 2 ;;
    -d|-p) shift ;;
    --) shift; pos=("$@"); break ;;
    *) pos+=("$1"); shift ;;
  esac
done

sdir() { printf '%s/sessions/%s' "$STATE" "$1"; }
current() { cat "$STATE/current" 2>/dev/null || true; }

split_target() {
  SESS=${1%%:*}
  if [ "$1" = "$SESS" ]; then
    WIN=""
  else
    WIN=${1#*:}
  fi
}

case "$cmd" in
  has-session)
    [ -d "$(sdir "$sess")" ] && exit 0 || exit 1
    ;;
  new-session)
    mkdir -p "$(sdir "$sess")"
    [ -n "$win" ] && : >"$(sdir "$sess")/$win"
    if [ "${TMUX_EXEC:-0}" = 1 ] && [ "${#pos[@]}" -gt 0 ]; then exec sh -c "${pos[0]}"; fi
    exit 0
    ;;
  new-window)
    [ -d "$(sdir "$sess")" ] || exit 1
    [ -n "$win" ] && : >"$(sdir "$sess")/$win"
    if [ "${TMUX_EXEC:-0}" = 1 ] && [ "${#pos[@]}" -gt 0 ]; then exec sh -c "${pos[0]}"; fi
    exit 0
    ;;
  list-windows)
    [ -d "$(sdir "$sess")" ] || exit 1
    for f in "$(sdir "$sess")"/*; do
      [ -e "$f" ] || continue
      basename "$f"
    done
    exit 0
    ;;
  select-window)
    split_target "$sess"
    [ -n "$SESS" ] && printf '%s' "$SESS" >"$STATE/current"
    exit 0
    ;;
  attach)
    exit 0
    ;;
  switch-client)
    [ -n "$sess" ] && printf '%s' "$sess" >"$STATE/current"
    exit 0
    ;;
  display-message)
    current
    exit 0
    ;;
  kill-window)
    split_target "$sess"
    [ -n "$WIN" ] && rm -f "$(sdir "$SESS")/$WIN"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
